---
import type { QuizQuestion } from '~/lib/api/client';
import { getInputName, getLocalizedText } from '~/lib/utils/quizHelpers';

interface Props {
  question: QuizQuestion;
  value?: unknown;
  locale?: string;
}

const { question, value = [], locale = 'en' } = Astro.props;
const selected = Array.isArray(value) ? value : [];
const name = getInputName(question);
---

<div class="grid gap-3 sm:grid-cols-2" data-question-multi>
  {
    question.options?.map((option) => (
      <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-gray-200 bg-white p-4 text-sm shadow-sm transition hover:border-primary dark:border-slate-700 dark:bg-slate-900">
        <input class="mt-1 h-4 w-4 rounded accent-primary" type="checkbox" name={name} value={option.id} checked={selected.includes(option.id)} />
        <span>{getLocalizedText(option.label, locale)}</span>
      </label>
    ))
  }
</div>
