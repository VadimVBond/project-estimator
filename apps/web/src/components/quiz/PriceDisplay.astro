---
interface Props {
  title?: string;
  emptyLabel?: string;
}

const { title = 'Estimate', emptyLabel = 'Complete the quiz to see pricing.' } = Astro.props;
---

<aside class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900" data-price-display>
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-sm font-medium text-gray-500 dark:text-gray-400">{title}</p>
      <p class="mt-1 text-3xl font-semibold text-gray-900 dark:text-white" data-price-total>—</p>
    </div>
    <div class="hidden h-8 w-8 animate-spin rounded-full border-2 border-gray-200 border-t-primary" data-price-loading></div>
  </div>
  <p class="mt-3 text-sm text-gray-500 dark:text-gray-400" data-price-empty>{emptyLabel}</p>
  <dl class="mt-5 hidden space-y-3 text-sm" data-price-lines></dl>
</aside>
