---
import QuestionMulti from './QuestionMulti.astro';
import QuestionSingle from './QuestionSingle.astro';
import type { QuizQuestion, ValidationIssue } from '~/lib/api/client';
import { getInputName, getLocalizedText } from '~/lib/utils/quizHelpers';

interface Props {
  question?: QuizQuestion | null;
  value?: unknown;
  issue?: ValidationIssue;
  locale?: string;
}

const { question = null, value, issue, locale = 'en' } = Astro.props;
---

<div data-step-renderer>
  {
    question ? (
      <fieldset class="space-y-5">
        <div>
          <legend class="text-xl font-semibold text-gray-900 dark:text-white">{getLocalizedText(question.title, locale)}</legend>
          {question.description && <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">{getLocalizedText(question.description, locale)}</p>}
        </div>

        {question.type === 'single-choice' && <QuestionSingle question={question} value={value} locale={locale} />}
        {question.type === 'multi-choice' && <QuestionMulti question={question} value={value} locale={locale} />}
        {question.type === 'boolean' && (
          <div class="flex flex-wrap gap-3">
            <label class="cursor-pointer rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm shadow-sm dark:border-slate-700 dark:bg-slate-900">
              <input class="mr-2 accent-primary" type="radio" name={getInputName(question)} value="true" checked={value === true} />Yes
            </label>
            <label class="cursor-pointer rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm shadow-sm dark:border-slate-700 dark:bg-slate-900">
              <input class="mr-2 accent-primary" type="radio" name={getInputName(question)} value="false" checked={value === false} />No
            </label>
          </div>
        )}
        {(question.type === 'text' || question.type === 'number') && (
          <input
            class="w-full rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm shadow-sm outline-none transition focus:border-primary dark:border-slate-700 dark:bg-slate-900"
            type={question.type === 'number' ? 'number' : 'text'}
            name={getInputName(question)}
            value={typeof value === 'string' || typeof value === 'number' ? String(value) : ''}
          />
        )}

        {issue && <p class="text-sm text-red-600" data-validation-message>{issue.message}</p>}
      </fieldset>
    ) : (
      <div class="rounded-lg border border-dashed border-gray-300 p-6 text-sm text-gray-500 dark:border-slate-700 dark:text-gray-300" data-empty-step>
        Loading quiz step...
      </div>
    )
  }
</div>
