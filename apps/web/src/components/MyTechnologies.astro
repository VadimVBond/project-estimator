---
import { SITE } from '~/utils/config';
import { useTranslations, getLocaleFromUrl } from '~/i18n/translator';

const base = SITE.base === '/' ? '' : SITE.base;
const lang = getLocaleFromUrl(Astro.url);
const { t } = useTranslations(lang);

const title = t('index.technologies.title');

const technologies = [
  { name: "Next.js", icon: "nextjs" },
  { name: "React.js", icon: "react" },
  { name: "Astro", icon: "astro" },
  { name: "Tailwind", icon: "tailwind" },
  { name: "Bootstrap", icon: "bootstrap" },
  { name: "JavaScript", icon: "javascript" },
  { name: "TypeScript", icon: "typescript" },
  { name: "CSS", icon: "css" },
  { name: "CSS Modules", icon: "css" },
  { name: "Git", icon: "git" },
  { name: "Github", icon: "github" },
  { name: "Vercel", icon: "vercel" },
  { name: "Netlify", icon: "netlify" },
  { name: "Yarn", icon: "yarn" },
  { name: "NPM", icon: "npm" },
  { name: "Styled Components", icon: "styledcomponents" },
];
---

<section class="py-16 bg-gray-50 dark:bg-slate-900 border-t border-gray-200 dark:border-slate-800">
  <div class="container mx-auto px-4 text-center">
    <h2 class="text-3xl md:text-4xl font-extrabold mb-12 text-gray-900 dark:text-white tracking-tighter">
      {title}
    </h2>

    <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-8 md:gap-10 justify-items-center">
      {
        technologies.map((tech) => (
          <div class="flex flex-col items-center space-y-3 group transition-all duration-300 transform hover:-translate-y-2">
            <div class="relative p-5 bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-gray-100 dark:border-slate-700 w-20 h-20 md:w-24 md:h-24 flex items-center justify-center transition-all group-hover:shadow-2xl group-hover:border-blue-500/50 dark:group-hover:border-blue-400/50">
              <img 
                src={`${base}/icons/${tech.icon}.svg`} 
                alt={tech.name} 
                class="w-12 h-12 md:w-14 md:h-14 object-contain filter grayscale group-hover:grayscale-0 transition-all duration-500 scale-90 group-hover:scale-110" 
                loading="lazy"
                onerror="this.style.opacity='0.3';"
              />
            </div>
            <span class="text-xs md:text-sm font-bold text-gray-500 dark:text-slate-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors uppercase tracking-widest">
              {tech.name}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
